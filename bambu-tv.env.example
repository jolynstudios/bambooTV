# bambooTV settings. install.sh writes these to /etc/bambu-tv/bambu-tv.env;
# for Docker, copy this file to bambu-tv.env next to compose.yaml.

# The printer's IP address (printer screen: Settings → Network). Give the
# printer a fixed IP (DHCP reservation in your router) so this keeps working.
PRINTER_IP=192.168.1.50

# The printer's LAN access code (printer screen: Settings → Network → Access Code).
ACCESS_CODE=a1b2c3d4

# Optional: background radio. Any MP3/AAC internet radio stream URL.
# Default when switched on: 181.FM Power 181 (US Top 40).
#RADIO_URL=https://listen.181fm.com/181-power_128k.mp3

# Optional: ports
#HTTP_PORT=1984
#RTSP_PORT=8554
#DLNA_PORT=49499

# Optional: require a login for RTSP clients (VLC, Home Assistant, NVRs)
#RTSP_USER=
#RTSP_PASS=

# Optional, DLNA only: advertise this LAN IP instead of detecting it per TV
#DLNA_LAN_IP=192.168.1.20
